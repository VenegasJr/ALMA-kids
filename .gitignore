# ============================================
# ALMA Kids - .gitignore
# ============================================

# API Keys - NUNCA subir a repositorios públicos
ai-chat-config.js

# Archivos de respaldo con API keys
ai-chat-config.js.bak
ai-chat-config.js.backup
*config*.js.bak

# Archivos temporales
*.tmp
*.temp
*.log
*.zip

# Notas y documentación temporal
NOTAS.txt
TODO.txt
PRUEBAS.txt

# Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Archivos de editores
.vscode/
.idea/
*.swp
*.swo
*~

# Archivos de Node (si se usa en el futuro)
node_modules/
package-lock.json
yarn.lock

# ============================================
# INSTRUCCIONES
# ============================================
# 
# Este archivo protege tu API key de OpenAI
# NO subas ai-chat-config.js con tu API key real
# 
# Si ya lo subiste por error:
# 1. Ve a GitHub y elimina el archivo
# 2. Ve a OpenAI y revoca la API key
# 3. Crea una nueva API key
# 4. Actualiza ai-chat-config.js con la nueva key
# 
# ============================================
